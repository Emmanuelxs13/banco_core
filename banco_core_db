CREATE FUNCTION public.aprobar_transferencia_validar_fondos() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    saldo_actual NUMERIC;
BEGIN

    -- Solo validar cuando se intenta aprobar
    IF NEW.estado_transferencia = 'APROBADA'
       AND OLD.estado_transferencia <> 'APROBADA' THEN

        -- Bloquea la cuenta para evitar conflictos concurrentes
        SELECT saldo_actual
        INTO saldo_actual
        FROM cuenta_bancaria
        WHERE numero_cuenta = NEW.cuenta_origen
        FOR UPDATE;

        -- Validar fondos
        IF saldo_actual < NEW.monto THEN
            RAISE EXCEPTION
            'Transferencia % rechazada: fondos insuficientes en cuenta %',
            NEW.id_transferencia,
            NEW.cuenta_origen;
        END IF;

        -- Restar saldo a la cuenta origen
        UPDATE cuenta_bancaria
        SET saldo_actual = saldo_actual - NEW.monto
        WHERE numero_cuenta = NEW.cuenta_origen;

        -- Sumar saldo a la cuenta destino
        UPDATE cuenta_bancaria
        SET saldo_actual = saldo_actual + NEW.monto
        WHERE numero_cuenta = NEW.cuenta_destino;

        -- Registrar fecha de aprobación
        NEW.fecha_aprobacion = NOW();

    END IF;

    RETURN NEW;

END;
$$;


